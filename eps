          "type": "object",
          "properties": {
            "pricingPlan": {
              "type": "string"
            }
          },
          "required": [
            "pricingPlan"
          ]
        },
        "CreateDirectUploadDto": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Video name",
              "example": "My Tutorial Video"
            },
            "maxDurationSeconds": {
              "type": "number",
              "description": "Maximum video duration in seconds",
              "example": 3600,
              "minimum": 1,
              "maximum": 7200
            },
            "maxSizeBytes": {
              "type": "number",
              "description": "Maximum file size in bytes",
              "example": 5368709120,
              "minimum": 1048576,
              "maximum": 10737418240
            },
            "allowedFormats": {
              "description": "Allowed video formats",
              "example": [
                "mp4",
                "mov",
                "avi"
              ],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "requireSignedURLs": {
              "type": "boolean",
              "description": "Require signed URLs for playback",
              "example": false
            },
            "thumbnailTimestampPct": {
              "type": "number",
              "description": "Thumbnail timestamp percentage (0.0 to 1.0)",
              "example": 0.5,
              "minimum": 0,
              "maximum": 1
            },
            "metadata": {
