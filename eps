            "interests"
          ]
        },
        "detailsDto": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "resume": {
              "type": "string",
              "format": "binary"
            },
            "video": {
              "type": "string",
              "format": "binary"
            }
          },
          "required": [
            "title",
            "description"
          ]
        },
        "resumeDto": {
          "type": "object",
          "properties": {
            "file": {
              "$ref": "#/components/schemas/MemoryStoredFile"
            }
          },
          "required": [
            "file"
          ]
        },
        "profileVideoDto": {
          "type": "object",
          "properties": {
            "file": {
              "$ref": "#/components/schemas/MemoryStoredFile"
            }
          },
          "required": [
            "file"
          ]
        },
